# Copy to .env for local use. Values marked SECRET must come from a secret manager in production.
# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-50-plus-random-characters # SECRET; required in production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152

# Database (SECRET); PostgreSQL is required in production, SQLite is the development default.
DATABASE_URL=postgres://studyease:password@localhost:5432/studyease
DATABASE_CONN_MAX_AGE=60

# Redis and Celery (URLs may be SECRET)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CACHE_URL=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=true
CELERY_TASK_SOFT_TIME_LIMIT=840
CELERY_TASK_TIME_LIMIT=900
DOCUMENT_LOCK_TIMEOUT=1200
HEALTH_REQUIRE_REDIS=false

# Private S3-compatible storage (all credentials SECRET; omit for local filesystem)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
AWS_QUERYSTRING_EXPIRE=300

# Malware scanning
MALWARE_SCANNER=fake
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Authentication and throttling
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
AUTH_RATE=10/minute
REGISTRATION_RATE=5/hour
UPLOAD_RATE=20/hour
QUIZ_SUBMISSION_RATE=60/hour
RAG_QUESTION_RATE=20/hour
RAG_PROCESSING_RATE=30/hour

# Email (password SECRET)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=studyEase <noreply@localhost>

# AI and vector search (API key SECRET; fake providers are safe defaults)
RAG_EMBEDDING_PROVIDER=fake
RAG_LANGUAGE_MODEL_PROVIDER=fake
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_LANGUAGE_MODEL=gpt-4.1-mini
RAG_VECTOR_BACKEND=database
RAG_VECTOR_DIMENSIONS=64
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_MIN_CHUNK_SIZE=80
RAG_RETRIEVAL_TOP_K=5
RAG_MAX_TOP_K=10
RAG_MAX_CONTEXT_CHARACTERS=12000
RAG_MIN_SIMILARITY=-1
RAG_HISTORY_MESSAGE_LIMIT=12
RAG_MAX_DOCUMENT_BYTES=10485760

# Logging and monitoring (tokens/DSN SECRET)
ENVIRONMENT=development
SERVICE_NAME=studyease-api
LOG_LEVEL=INFO
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
